{
  "name": "codemirror_generator",
  "version": "1.0.0",
  "description": "CodeMirror 6 bundle generator with configurable extensions and One Dark theme",
  "main": "scripts/build.js",
  "scripts": {
    "build": "node scripts/build.js",
    "build:preview": "node -e \"require('./scripts/build').buildPreviewBundle().then(p=>console.log('Preview:',p))\"",
    "dev": "node scripts/dev-server.js",
    "start": "npm run dev",
    "preview": "npm run dev"
  },
  "keywords": [
    "codemirror",
    "generator",
    "iife"
  ],
  "author": "cheng",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "archiver": "^7.0.1",
    "codemirror": "^6.0.2",
    "rollup": "^4.60.3"
  }
}
